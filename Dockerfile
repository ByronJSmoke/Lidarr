# syntax=docker/dockerfile:1FROM ghcr.io/linuxserver/baseimage-alpine:3.21# set version labelARG BUILD_DATEARG VERSIONARG LIDARR_RELEASELABEL build_version="version:- ${VERSION} Build-date:- ${BUILD_DATE}"LABEL maintainer="ByronJSmoke"# environment settingsARG LIDARR_BRANCH="master"ENV XDG_CONFIG_HOME="/config/xdg" \  COMPlus_EnableDiagnostics=0 \  TMPDIR=/run/lidarr-tempRUN \  echo "**** install packages ****" && \  apk add -U --upgrade --no-cache \    chromaprint \    icu-libs \    sqlite-libs \    xmlstarlet && \  echo "**** install lidarr ****" && \  mkdir -p /app/lidarr/bin && \  curl -o \    /tmp/lidarr.tar.gz -L && \    "https://github.com/ByronJSmoke/Lidarr/releases/download/v2.9.1.4517_01/Lidarr.plugins-enhancements.v2.9.1.4517_01.linux-musl-core-x64.tar.gz" && \  tar xzf \    /tmp/lidarr.tar.gz -C \    /app/lidarr/bin --strip-components=1 && \  echo -e "UpdateMethod=docker\nBranch=${LIDARR_BRANCH}\nPackageVersion=${VERSION}\nPackageAuthor=[linuxserver.io](https://linuxserver.io)" > /app/lidarr/package_info && \  printf "Linuxserver.io version: ${VERSION}\nBuild-date: ${BUILD_DATE}" > /build_version && \  echo "**** cleanup ****" && \  rm -rf \    /app/lidarr/bin/Lidarr.Update \    /tmp/*# copy local filesCOPY root/ /# ports and volumesEXPOSE 8686VOLUME /config